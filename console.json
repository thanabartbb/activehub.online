{
  "app": {
    "id": "agensdkdos-console",
    "title": "AGENSDKDOS — Carbon Olive AI Console",
    "language": "th",
    "source": "agensdkdos_web-carbon-olive.zip (index.html)"
  },
  "screens": [
    {
      "id": "landing",
      "elementId": "screen-landing",
      "label": "Landing"
    },
    {
      "id": "home",
      "elementId": "screen-home",
      "label": "Home"
    },
    {
      "id": "projects",
      "elementId": "screen-projects",
      "label": "Projects"
    },
    {
      "id": "detail",
      "elementId": "screen-detail",
      "label": "Service Detail"
    }
  ],
  "actions": {
    "switchScreen": {
      "params": [
        {
          "name": "screenId",
          "type": "string"
        }
      ],
      "description": "สลับหน้าจอด้วย cross-fade animation, ซ่อน/โชว์ bottom nav bar เฉพาะหน้า home กับ projects"
    },
    "updateBottomNavTabs": {
      "params": [
        {
          "name": "screenId",
          "type": "string"
        }
      ],
      "description": "อัพเดตสถานะ active indicator ของแท็บ home/projects ใน bottom nav (เรียกจาก switchScreen อัตโนมัติ ไม่ได้ผูกกับปุ่มโดยตรง)"
    },
    "setProjectFilter": {
      "params": [
        {
          "name": "element",
          "type": "$element",
          "note": "ปุ่มที่ถูกกด ใช้ toggle class active"
        },
        {
          "name": "filterType",
          "type": "string"
        }
      ],
      "description": "เปลี่ยน filter pill ที่ active ในหน้า projects แล้วโชว์ toast บอกชื่อ filter ที่เลือก"
    },
    "selectService": {
      "params": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "endpoint",
          "type": "string"
        },
        {
          "name": "type",
          "type": "string",
          "note": "รับค่าแต่ปัจจุบันไม่ได้ใช้ในฟังก์ชัน (dead param จากต้นฉบับ)"
        },
        {
          "name": "desc",
          "type": "string"
        },
        {
          "name": "dotColor",
          "type": "string",
          "note": "รับค่าแต่ปัจจุบันไม่ได้ใช้ในฟังก์ชัน (dead param จากต้นฉบับ)"
        }
      ],
      "description": "เติมข้อมูล service ที่เลือกลงหน้า detail (title/endpoint/desc/run-button text) แล้วสลับไปหน้า detail"
    },
    "showConnectModal": {
      "params": [],
      "description": "เปิด modal เชื่อมต่อ repository"
    },
    "hideConnectModal": {
      "params": [],
      "description": "ปิด modal เชื่อมต่อ repository"
    },
    "simulateConnect": {
      "params": [
        {
          "name": "provider",
          "type": "string"
        }
      ],
      "description": "ปิด connect modal แล้วโชว์ toast จำลองการเชื่อมต่อกับ provider ที่ระบุ"
    },
    "showLoginModal": {
      "params": [],
      "description": "เปิด modal เข้าสู่ระบบ"
    },
    "hideLoginModal": {
      "params": [],
      "description": "ปิด modal เข้าสู่ระบบ"
    },
    "simulateLogin": {
      "params": [
        {
          "name": "provider",
          "type": "string"
        }
      ],
      "description": "ปิด login modal, โชว์ toast, แล้วสลับไปหน้า home อัตโนมัติหลังจาก 900ms"
    },
    "openRightDrawer": {
      "params": [],
      "description": "เปิด drawer เมนูด้านขวา (overlay + slide-in panel)"
    },
    "closeRightDrawer": {
      "params": [
        {
          "name": "event",
          "type": "$event",
          "optional": true,
          "note": "ถ้ามาจากคลิก overlay จะเช็คว่าไม่ได้คลิกโดน panel เอง (กัน bubbling)"
        }
      ],
      "description": "ปิด drawer เมนูด้านขวา"
    },
    "toggleRightDrawer": {
      "params": [],
      "description": "สลับเปิด/ปิด drawer เมนูด้านขวาตามสถานะปัจจุบัน"
    },
    "handleDrawerServiceClick": {
      "params": [
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "endpoint",
          "type": "string"
        }
      ],
      "description": "ปิด drawer, โชว์ toast, แล้วเรียก selectService ด้วยค่า default type='Edge Service'"
    },
    "triggerRunAgent": {
      "params": [],
      "description": "จำลองการรัน agent ใน sandbox พร้อม toast แจ้งเตือน"
    },
    "showToast": {
      "params": [
        {
          "name": "message",
          "type": "string"
        }
      ],
      "description": "โชว์ toast notification ที่มุมบน ค้าง 2.6 วินาทีแล้วซ่อนอัตโนมัติ"
    }
  },
